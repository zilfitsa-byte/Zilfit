{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZILFIT Mesh Runtime Schema",
  "description": "Schema for mesh extraction metadata — gyroid voxel-to-mesh pipeline output",
  "type": "object",
  "required": [
    "mesh_id",
    "timestamp",
    "source_field_id",
    "edition",
    "is_hybrid",
    "grid_shape",
    "voxel_count",
    "vertex_count",
    "triangle_count",
    "bounding_box",
    "surface_area_mm2",
    "volume_mm3",
    "manifold_report",
    "printability_report",
    "quality_summary"
  ],
  "properties": {
    "mesh_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this mesh extraction"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of mesh extraction"
    },
    "source_field_id": {
      "type": "string",
      "description": "ID of the gyroid field this mesh was extracted from"
    },
    "edition": {
      "type": "string",
      "enum": ["CALM", "FEMME", "VITAL", "HYBRID", "UNKNOWN"],
      "description": "ZILFIT edition type"
    },
    "is_hybrid": {
      "type": "boolean",
      "description": "Whether this is a hybrid (multi-edition) mesh"
    },
    "grid_shape": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 3,
      "maxItems": 3,
      "description": "[nx, ny, nz] voxel grid dimensions"
    },
    "voxel_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of voxels in the volume"
    },
    "vertex_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of vertices in the extracted mesh"
    },
    "triangle_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of triangles in the extracted mesh"
    },
    "bounding_box": {
      "type": "object",
      "required": ["x_min", "x_max", "y_min", "y_max", "z_min", "z_max"],
      "properties": {
        "x_min": {"type": "number"},
        "x_max": {"type": "number"},
        "y_min": {"type": "number"},
        "y_max": {"type": "number"},
        "z_min": {"type": "number"},
        "z_max": {"type": "number"}
      },
      "additionalProperties": false
    },
    "surface_area_mm2": {
      "type": "number",
      "minimum": 0,
      "description": "Total mesh surface area in mm²"
    },
    "volume_mm3": {
      "type": "number",
      "minimum": 0,
      "description": "Mesh volume via divergence theorem in mm³"
    },
    "manifold_report": {
      "type": "object",
      "required": [
        "is_watertight",
        "is_manifold",
        "total_vertices",
        "total_triangles",
        "boundary_edges_count",
        "self_intersections",
        "duplicate_vertices",
        "summary"
      ],
      "properties": {
        "is_watertight": {"type": "boolean"},
        "is_manifold": {"type": "boolean"},
        "total_vertices": {"type": "integer", "minimum": 0},
        "total_triangles": {"type": "integer", "minimum": 0},
        "non_manifold_edges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "integer"},
            "minItems": 2,
            "maxItems": 2
          }
        },
        "boundary_edges_count": {"type": "integer", "minimum": 0},
        "self_intersections": {"type": "integer", "minimum": 0},
        "duplicate_vertices": {"type": "integer", "minimum": 0},
        "summary": {"type": "string"}
      }
    },
    "printability_report": {
      "type": "object",
      "required": [
        "printable",
        "score",
        "checks",
        "warnings",
        "blockers",
        "min_feature_size_mm",
        "thin_wall_count",
        "degenerate_triangles",
        "inverted_triangles",
        "max_aspect_ratio",
        "avg_triangle_area_mm2"
      ],
      "properties": {
        "printable": {"type": "boolean"},
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Printability score [0.0, 1.0]"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "passed", "detail"],
            "properties": {
              "name": {"type": "string"},
              "passed": {"type": "boolean"},
              "detail": {"type": "string"}
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "blockers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "min_feature_size_mm": {"type": "number", "minimum": 0},
        "thin_wall_count": {"type": "integer", "minimum": 0},
        "degenerate_triangles": {"type": "integer", "minimum": 0},
        "inverted_triangles": {"type": "integer", "minimum": 0},
        "max_aspect_ratio": {"type": "number", "minimum": 1.0},
        "avg_triangle_area_mm2": {"type": "number", "minimum": 0}
      }
    },
    "quality_summary": {
      "type": "object",
      "required": [
        "total_triangles_analyzed",
        "min_area_mm2",
        "max_area_mm2",
        "avg_area_mm2",
        "max_aspect_ratio"
      ],
      "properties": {
        "total_triangles_analyzed": {"type": "integer", "minimum": 0},
        "degenerate_count": {"type": "integer", "minimum": 0},
        "inverted_count": {"type": "integer", "minimum": 0},
        "min_area_mm2": {"type": "number", "minimum": 0},
        "max_area_mm2": {"type": "number", "minimum": 0},
        "avg_area_mm2": {"type": "number", "minimum": 0},
        "max_aspect_ratio": {"type": "number", "minimum": 1.0}
      }
    }
  },
  "additionalProperties": false
}
