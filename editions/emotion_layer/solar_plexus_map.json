  "mapping_concept": {
    "description": "Maps foot contact zones to reflexology-inspired sensory targets and emotional comfort states. Each zone corresponds to a pressure/stimulation profile in the Gyroid TPU lattice. Z-CAD uses zone names to generate geometry. Z-Bio uses zone pressure targets to score comfort.",
    "coordinate_system": "foot_regions + relative_depth",
    "total_zones": 18,
    "coverage": "full_plantar_surface"
  },
  "editions": {
    "calm": {
