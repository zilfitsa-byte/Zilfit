  "usage_rules": {
    "zone_activation": {
      "description": "Not all zones are active in every edition. Each edition activates only its relevant zones. Inactive zones receive default neutral stimulation (density 0.30, smooth surface).",
      "inactive_default_density": 0.30,
      "inactive_default_shape": "smooth_surface"
    },
    "max_zone_count_per_edition": 6,
    "overlapping_zones_rule": "If two editions share a zone (e.g., heel_recovery_basin + heel_containment_soft_edge both map to heel), density = weighted average based on primary/secondary weight from emotional_recipe.json.",
    "cad_integration": {
      "description": "Z-CAD reads zone_geometry_hints from this file and generates Gyroid 0.6mm lattice geometry matching the specified shapes, depths, and dimensions.",
      "cad_input_fields": ["shape", "depth_mm", "diameter_mm", "height_mm", "wall_thickness_mm", "cad_direction"],
      "cad_output_format": "STL or 3MF with zone-specific gyroid density modulation"
    },
    "bio_integration": {
      "description": "Z-Bio reads max_pressure_kpa per zone and checks whether simulated plantar pressure exceeds safe thresholds for each scenario (weight, arch type, gait phase).",
      "bio_check_fields": ["max_pressure_kpa", "heel_pressure_kpa", "zone_intensity"],
      "bio_output": "comfort_score per zone + overall edition score + flag zones exceeding max_pressure_kpa"
    }
  },
